{
    "scenes": [
        {
            "id": "deliberation",
            "background": "bg/woods.png",
            "objects": [
                {
                    "id": "goals",
                    "visible": true,
                    "type": "tasklist",
                    "content": "Choices & Outcomes",
                    "x": "7%",
                    "y": "15%",
                    "z": "1",
                    "no_line_through": true,
                    "answer_options": [
                        {
                            "content": "Finished your regular Promotion",
                            "done_condition": "!variables.exceeded_cycle4_time && !variables.exceeded_cycle3_time",
                            "next_instruction": "[ You did not use time of the regular harvest ]",
                            "disabled": {
                                "condition": "!variables.enabled",
                                "explanation": "[ You used time of the regular harvest ]"
                            }
                        },
                        {
                            "content": "Finished the extra Promotion",
                            "done_condition": "variables.harvest_plan_send == true",
                            "next_instruction": "[ You did finish all tasks ]",
                            "disabled": {
                                "condition": "!variables.enabled",
                                "explanation": "[ You did not finish all tasks ]"
                            }
                        },
                        {
                            "content": "You got another role in the tribe",
                            "done_condition": "variables.future_aim_archieved == true && variables.future_aim_role == true",
                            "next_instruction": "[ You went to the role conference ]",
                            "condition": "variables.future_aim_role == true",
                            "disabled": {
                                "condition": "!variables.enabled",
                                "explanation": "[ You did not go to role conference ]"
                            }
                        },
                        {
                            "content": "Willaferna and you started to live together",
                            "done_condition": "variables.future_aim_archieved == true && variables.future_aim_house == true",
                            "next_instruction": "[ You did inspect the Nestling Nook ]",
                            "condition": "variables.future_aim_house == true",
                            "disabled": {
                                "condition": "!variables.enabled",
                                "explanation": "[ You did not inspect the Nestling Nook ]"
                            }
                        },
                        {
                            "content": "Julia and you both were allowed to your next promotion",
                            "done_condition": "variables.future_aim_archieved == true && variables.future_aim_promotion == true",
                            "next_instruction": "[ You went go to the promotion conference ]",
                            "condition": "variables.future_aim_promotion == true",
                            "disabled": {
                                "condition": "!variables.enabled",
                                "explanation": "[ You did not go to the promotion conference ]"
                            }
                        }
                    ]
                },
                {
                    "id": "reflection_question",
                    "type": "textinput",
                    "visible": true,
                    "y": "15%",
                    "x": "43%",
                    "width": "50%",
                    "button_text": "Finish",
                    "global_instruction": "Please answer the questions below and press finish.",
                    "questions": [
                        {
                            "id": "statisfied",
                            "question": "Are you statisfied with the choices you made in the game? Why?",
                            "value": ""
                        },
                        {
                            "id": "relate",
                            "question": "Could you relate the choices you made in the game to situations in daily life? If yes, please give an example.",
                            "value": ""
                        },
                        {
                            "id": "different",
                            "question": "Based on the outcomes, would you make different choices if you replayed the game or even in daily life? Why?",
                            "value": ""
                        }
                    ],
                    "events": [
                        {
                            "type": "set_variable",
                            "variable": "Answer",
                            "value": "context"
                        },
                        {
                            "type": "goto_scene",
                            "target": "start"
                        }
                    ]
                }
            ],
            "events": [
                {
                    "type": "set_variable",
                    "variable": "enabled",
                    "value": true
                }
            ]
        }
