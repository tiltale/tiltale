{
    "scenes": [
        {
            "id": "reflection",
            "background": "bg/campus.png",
            "objects": [
                {
                    "id": "goals",
                    "visible": true,
                    "type": "tasklist",
                    "content": "Choices & Outcomes",
                    "x": "7%",
                    "y": "15%",
                    "z": "1",
                    "no_line_through": true,
                    "answer_options": [
                        {
                            "content": "Finished your Degree",
                            "done_condition": "!variables.exceeded_week4_course_time && !variables.exceeded_week3_course_time",
                            "next_instruction": "[ You did not use time of other courses ]",
                            "disabled": {
                                "condition": "!variables.enabled",
                                "explanation": "[ You used time of other courses ]"
                            }
                        },
                        {
                            "content": "Finished the extra course",
                            "done_condition": "variables.outline_send == true",
                            "next_instruction": "[ You did finish all tasks ]",
                            "disabled": {
                                "condition": "!variables.enabled",
                                "explanation": "[ You did not finish all tasks ]"
                            }
                        },
                        {
                            "content": "You got a Job",
                            "done_condition": "variables.future_goal_archieved == true && variables.future_aim_job == true",
                            "next_instruction": "[ You went to the job interview ]",
                            "condition": "variables.future_aim_job == true",
                            "disabled": {
                                "condition": "!variables.enabled",
                                "explanation": "[ You did not go to the job interview ]"
                            }
                        },
                        {
                            "content": "Julia and you started to live together",
                            "done_condition": "variables.future_goal_archieved == true && variables.future_aim_girlfriend == true",
                            "next_instruction": "[ You did inspect the house ]",
                            "condition": "variables.future_aim_girlfriend == true",
                            "disabled": {
                                "condition": "!variables.enabled",
                                "explanation": "[ You did not go and inspect the house ]"
                            }
                        },
                        {
                            "content": "Julia and you both were allowed to your masters",
                            "done_condition": "variables.future_goal_archieved == true && variables.future_aim_degree == true",
                            "next_instruction": "[ You went go to the degree application ]",
                            "condition": "variables.future_aim_degree == true",
                            "disabled": {
                                "condition": "!variables.enabled",
                                "explanation": "[ You did not go to the degree application ]"
                            }
                        }
                    ]
                },
                {
                    "id": "reflection_question",
                    "type": "textinput",
                    "visible": true,
                    "y": "15%",
                    "x": "43%",
                    "width": "50%",
                    "button_text": "Finish",
                    "global_instruction": "Please answer the questions below and press finish.",
                    "questions": [
                        {
                            "id": "statisfied",
                            "question": "Are you statisfied with the choices you made in the game? Why?",
                            "value": ""
                        },
                        {
                            "id": "relate",
                            "question": "Could you relate the choices you made in the game to situations in daily life? If yes, please give an example.",
                            "value": ""
                        },
                        {
                            "id": "different",
                            "question": "Based on the outcomes, would you make different choices if you replayed the game, or if you would encounter a similar situation in real life? Why?",
                            "value": ""
                        }
                    ],
                    "events": [
                        {
                            "type": "set_variable",
                            "variable": "Answer",
                            "value": "context"
                        },
                        {
                            "type": "goto_scene",
                            "target": "start"
                        }
                    ]
                }
            ],
            "events": [
                {
                    "type": "set_variable",
                    "variable": "enabled",
                    "value": true
                }
            ]
        }
    ]
}