        {
            "id": "epilogue_willafernna1",
            "background": "bg/willaferna.png",
            "objects": [
                {
                    "id": "epilogue_winnaferna",
                    "type": "scrollingdialogue",
                    "x": "20%",
                    "y": "8%",
                    "z": "1",                    
                    "width": "60%",
                    "height": "80%",
                    "visible": true,
                    "objects": [
                        {
                            "id": "top",
                            "type": "sprite",
                            "width": "88%",
                            "visible": true,
                            "text": "<h1>2 months later...</h1><p style='font-size: 1.2vw'>After congratulating Flicktail after the leafing ceremony, you and Willaferna went to the park.</p>"
                        },
                        {
                            "id": "avatars",
                            "type": "avatars",
                            "visible": true,
                            "objects": [
                                {
                                    "id": "player",
                                    "name": "player",
                                    "img": "/project/img/avatars/player.png",
                                    "visible": true
                                },
                                {
                                    "id": "willaferna",
                                    "name": "willaferna",
                                    "img": "/project/img/avatars/willaferna.png",
                                    "visible": true
                                }
                            ]
                        },
                        {
                            "id": "texts",
                            "type": "texts",
                            "text_size": "15px",
                            "width": "90%",
                            "height": "80%",
                            "background": "#DDFFE0",
                            "visible": true,
                            "dialogue": [
                                {
                                    "id": "sp_willaferna1",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "&#91; Leans against you &#93; So...",
                                    "name": "Willaferna",
                                    "name_color": "#ab2e79",
                                    "avatar_id": "willaferna"
                                },
                                {
                                    "id": "sp_willaferna2",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "What are you thinking about?",
                                    "name": "Willaferna",
                                    "name_color": "#ab2e79",
                                    "avatar_id": "willaferna"
                                },
                                {
                                    "id": "sp_player1",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "I dunno, eh... I mean sometimes I'd have wished things differently...",
                                    "name": "You",
                                    "name_color": "#6143CF",
                                    "avatar_id": "player",
                                    "is_player": true
                                },
                                {
                                    "id": "sp_willaferna3",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "You mean, that you did not get your promotion done in time?",
                                    "name": "Willaferna",
                                    "name_color": "#ab2e79",
                                    "avatar_id": "willaferna"
                                },
                                {
                                    "id": "sp_player2",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "Yeah, and everyting attached to that...",
                                    "name": "You",
                                    "name_color": "#6143CF",
                                    "avatar_id": "player",
                                    "is_player": true
                                },
                                {
                                    "id": "sp_willaferna4",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "Maybe we both just wanted too much.",
                                    "name": "Willaferna",
                                    "name_color": "#ab2e79",
                                    "avatar_id": "willaferna"
                                },
                                {
                                    "id": "sp_willaferna5",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "On the other hand, now we have more time together.",
                                    "name": "Willaferna",
                                    "name_color": "#ab2e79",
                                    "avatar_id": "willaferna"
                                },
                                {
                                    "id": "sp_willaferna6_future_aim_failed",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "&#91; Hugs you tightly &#93;",
                                    "name": "Willaferna",
                                    "name_color": "#ab2e79",
                                    "avatar_id": "willaferna",
                                    "answer_options": [
                                        {
                                            "type": "next",
                                            "events": [
                                                {
                                                    "type": "goto_scene",
                                                    "target": "deliberation"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "sp_willaferna6_future_aim_house_succes",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "While you finish the loose ends of your promotion, we can start to renovate our Nestling Nook a little.",
                                    "name": "Willaferna",
                                    "name_color": "#ab2e79",
                                    "avatar_id": "willaferna"
                                },
                                {
                                    "id": "sp_willaferna6_future_aim_role_succes",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "And you're still getting that other role in the tribe after you finilize your promotion.",
                                    "name": "Willaferna",
                                    "name_color": "#ab2e79",
                                    "avatar_id": "willaferna"
                                },
                                {
                                    "id": "sp_willaferna6_future_aim_promotion_succes",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "And you're still allowed to the following promotion, only after the regular one is done.",
                                    "name": "Willaferna",
                                    "name_color": "#ab2e79",
                                    "avatar_id": "willaferna"
                                },
                                {
                                    "id": "sp_willaferna7_future_aim_succes",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "&#91; Hugs you tightly &#93;",
                                    "name": "Willaferna",
                                    "name_color": "#ab2e79",
                                    "avatar_id": "willaferna",
