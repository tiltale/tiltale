        {
            "id": "epilogue_graduation1",
            "background": "bg/graduation.png",
            "objects": [
                {
                    "id": "graduation_ceremony",
                    "type": "scrollingdialogue",
                    "x": "20%",
                    "y": "8%",
                    "z": "1",                    
                    "width": "60%",
                    "height": "80%",
                    "visible": true,
                    "objects": [
                        {
                            "id": "top",
                            "type": "sprite",
                            "width": "88%",
                            "visible": true,
                            "text": "<h1>4 months later...</h1><p style='font-size: 1.2vw'>The graduation ceremony has just finished. Everyone is joyfully chatting and enjoying cocktails.</p>"
                        },
                        {
                            "id": "avatars",
                            "type": "avatars",
                            "visible": true,
                            "objects": [
                                {
                                    "id": "student",
                                    "name": "student",
                                    "img": "/project/img/avatars/student.png",
                                    "visible": true
                                },
                                {
                                    "id": "julia",
                                    "name": "teacher",
                                    "img": "/project/img/avatars/julia.png"
                                },
                                {
                                    "id": "teacher",
                                    "name": "teacher",
                                    "img": "/project/img/avatars/teacher.png",
                                    "visible": false
                                },
                                {
                                    "id": "lisa",
                                    "name": "lisa",
                                    "img": "/project/img/avatars/lisa.png",
                                    "visible": false
                                }
                            ]
                        },
                        {
                            "id": "texts",
                            "type": "texts",
                            "text_size": "15px",
                            "width": "90%",
                            "height": "80%",
                            "background": "#DDFFE0",
                            "visible": true,
                            "dialogue": [
                                {
                                    "id": "sp_student1",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "Pfew, that's that. The signature is in place, speeches done, let's have a drink! &#91; Walks to the table with champagne glasses &#93;",
                                    "name": "You",
                                    "name_color": "#6143CF",
                                    "avatar_id": "student",
                                    "is_player": true
                                },
                                {
                                    "id": "sp_julia1",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "Haha, some fuss about the whole thing is only well deserved right? &#91; Hugs and toasts with you &#93;",
                                    "name": "Julia",
                                    "name_color": "#ab2e79",
                                    "avatar_id": "julia"
                                },
                                {
                                    "id": "sp_teacher1",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "&#91; Handshake &#93; Congrats with finishing your bachelors! Are you gonna miss it?",
                                    "name": "Teacher",
                                    "name_color": "#DC6060",
                                    "avatar_id": "teacher"
                                },
                                {
                                    "id": "sp_student2",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "Well honestly I ...",
                                    "name": "You",
                                    "name_color": "#6143CF",
                                    "avatar_id": "student",
                                    "is_player": true
                                },
                                {
                                    "id": "sp_teacher2",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "O wait a sec, there's a colegue of mine which I need to talk to. See ya!",
                                    "name": "Teacher",
                                    "name_color": "#DC6060",
                                    "avatar_id": "teacher"
                                },
                                {
                                    "id": "sp_lisa1",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "&#91; Grimace &#93; So, that ended quickly!",
                                    "name": "Lisa",
                                    "name_color": "#F5B841",
                                    "avatar_id": "lisa"
                                },
                                {
                                    "id": "sp_student3",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "Not that I was going to give an honest answer either! But let's forget about it. Congrats btw!",
                                    "name": "You",
                                    "name_color": "#6143CF",
                                    "avatar_id": "student",
                                    "is_player": true
                                },
                                {
                                    "id": "sp_lisa2",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "&#91; Hugs &#93; yeah you too! I am so relieved we made it!",
                                    "name": "Lisa",
                                    "name_color": "#F5B841",
                                    "avatar_id": "lisa"
                                },
                                {
                                    "id": "sp_lisa3",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "So...",
                                    "name": "Lisa",
                                    "name_color": "#F5B841",
                                    "avatar_id": "lisa"
                                },
                                {
                                    "id": "sp_lisa4",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "Do you guys have already more defined plans for what's next?",
                                    "name": "Lisa",
                                    "name_color": "#F5B841",
                                    "avatar_id": "lisa"
                                },
                                {
                                    "id": "sp_student4_future_aim_failed",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "Well uhm...  &#91; Looks at Julia &#93;",
                                    "name": "You",
                                    "name_color": "#6143CF",
                                    "avatar_id": "student",
                                    "is_player": true
                                },
                                {
                                    "id": "sp_julia2_future_aim_failed",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "We were going to work that out while [Name] had that extra course. Turns out that was not attainable at all.",
                                    "name": "Julia",
                                    "name_color": "#ab2e79",
                                    "avatar_id": "julia"
                                },
                                {
                                    "id": "sp_student5_future_aim_failed_girlfriend",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "So now we have to find another house, but you know how the market is right now.",
                                    "name": "You",
                                    "name_color": "#6143CF",
                                    "avatar_id": "student",
                                    "is_player": true
                                },
                                {
                                    "id": "sp_student5_future_aim_failed_degree",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "So now I have to wait a year before I can apply for my next degree.",
                                    "name": "You",
                                    "name_color": "#6143CF",
                                    "avatar_id": "student",
                                    "is_player": true
                                },
                                {
                                    "id": "sp_student5_future_aim_failed_job",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "I couldn't go to that job application a few months back. So now I have to find something else.",
                                    "name": "You",
                                    "name_color": "#6143CF",
                                    "avatar_id": "student",
                                    "is_player": true
                                },
                                {
                                    "id": "sp_julia3_future_aim_failed",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "Luckily he has at least his bachelors now. So that opens enough doors for the future. An we have each other. &#91; Smiles at you &#93;",
                                    "name": "Julia",
                                    "name_color": "#ab2e79",
                                    "avatar_id": "julia",
                                    "answer_options": [
                                        {
                                            "type": "next",
                                            "events": [
                                                {
                                                    "type": "goto_scene",
                                                    "target": "reflection"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "sp_julia2_future_aim_succes",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "We worked that out while [Name] had that extra course. In the end that group project was going to fail anyways.",
                                    "name": "Julia",
                                    "name_color": "#ab2e79",
                                    "avatar_id": "julia"
                                },
                                {
                                    "id": "sp_lisa5_future_aim_succes",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "&#91; Sighs &#93; Yeah right! What a mess was that!",
                                    "name": "Lisa",
                                    "name_color": "#F5B841",
                                    "avatar_id": "lisa"
                                },
                                {
                                    "id": "sp_julia3_future_aim_succes_girlfriend",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "We found a new place where we can start live together. &#91; Holds your arm tightly &#93;",
                                    "name": "Julia",
                                    "name_color": "#ab2e79",
                                    "avatar_id": "julia"
                                },
                                {
                                    "id": "sp_julia3_future_aim_succes_degree",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "We both were accepted for the same masters degree. So we more or the less pushed back real decisions for another two years &#91; Winks at you &#93;",
                                    "name": "Julia",
                                    "name_color": "#ab2e79",
                                    "avatar_id": "julia"
                                },
                                {
                                    "id": "sp_julia3_future_aim_succes_job",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "[Name] got a new job, so we are currently looking for an house to start living together. &#91; Holds your arm tightly &#93;",
                                    "name": "Julia",
                                    "name_color": "#ab2e79",
                                    "avatar_id": "julia"
                                },
                                {
                                    "id": "sp_lisa6_future_aim_succes",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "Aww so nice for both of you! I am so happy for you both! &#91; Hugs you both &#93;",
                                    "name": "Lisa",
                                    "name_color": "#F5B841",
                                    "avatar_id": "lisa",
                                    "answer_options": [
                                        {
                                            "type": "next",
                                            "events": [
                                                {
                                                    "type": "goto_scene",
                                                    "target": "reflection"
                                                }
                                            ]
                                        }
                                    ]
                                }                                                                                                                                                                                                                                                                                                                                                                             
                            ]
                        }
