        {
            "id": "epilogue_julia1",
            "background": "bg/park.png",
            "objects": [
                {
                    "id": "epilogue_julia",
                    "type": "scrollingdialogue",
                    "x": "20%",
                    "y": "8%",
                    "z": "1",                    
                    "width": "60%",
                    "height": "80%",
                    "visible": true,
                    "objects": [
                        {
                            "id": "top",
                            "type": "sprite",
                            "width": "88%",
                            "visible": true,
                            "text": "<h1>4 months later...</h1><p style='font-size: 1.2vw'>After congratulating Lisa after the ceremony, you and Julia went to the park.</p>"
                        },
                        {
                            "id": "avatars",
                            "type": "avatars",
                            "visible": true,
                            "objects": [
                                {
                                    "id": "student",
                                    "name": "student",
                                    "img": "/project/img/avatars/student.png",
                                    "visible": true
                                },
                                {
                                    "id": "julia",
                                    "name": "julia",
                                    "img": "/project/img/avatars/julia.png",
                                    "visible": true
                                }
                            ]
                        },
                        {
                            "id": "texts",
                            "type": "texts",
                            "text_size": "15px",
                            "width": "90%",
                            "height": "80%",
                            "background": "#DDFFE0",
                            "visible": true,
                            "dialogue": [
                                {
                                    "id": "sp_julia1",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "&#91; Leans against you &#93; So...",
                                    "name": "Julia",
                                    "name_color": "#ab2e79",
                                    "avatar_id": "julia"
                                },
                                {
                                    "id": "sp_julia2",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "What are you thinking about?",
                                    "name": "Julia",
                                    "name_color": "#ab2e79",
                                    "avatar_id": "julia"
                                },
                                {
                                    "id": "sp_student1",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "I dunno, eh... I mean sometimes I'd have wished things differently...",
                                    "name": "You",
                                    "name_color": "#6143CF",
                                    "avatar_id": "student",
                                    "is_player": true
                                },
                                {
                                    "id": "sp_julia3",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "You mean, that you did not get your degree in time?",
                                    "name": "Julia",
                                    "name_color": "#ab2e79",
                                    "avatar_id": "julia"
                                },
                                {
                                    "id": "sp_student2",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "Yeah, and everyting attached to that...",
                                    "name": "You",
                                    "name_color": "#6143CF",
                                    "avatar_id": "student",
                                    "is_player": true
                                },
                                {
                                    "id": "sp_julia4",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "Maybe we both just wanted too much.",
                                    "name": "Julia",
                                    "name_color": "#ab2e79",
                                    "avatar_id": "julia"
                                },
                                {
                                    "id": "sp_julia5",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "On the other hand, now we have more time together.",
                                    "name": "Julia",
                                    "name_color": "#ab2e79",
                                    "avatar_id": "julia"
                                },
                                {
                                    "id": "sp_julia6_future_goal_failed",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "&#91; Hugs you tightly &#93;",
                                    "name": "Julia",
                                    "name_color": "#ab2e79",
                                    "avatar_id": "julia",
                                    "answer_options": [
                                        {
                                            "type": "next",
                                            "events": [
                                                {
                                                    "type": "goto_scene",
                                                    "target": "reflection"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "sp_julia6_future_goal_girlfriend_succes",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "While you finish the loose ends of your degree, we can start to renovate our house a little.",
                                    "name": "Julia",
                                    "name_color": "#ab2e79",
                                    "avatar_id": "julia"
                                },
                                {
                                    "id": "sp_julia6_future_goal_job_succes",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "And you're still getting that job after you finilize your degree.",
                                    "name": "Julia",
                                    "name_color": "#ab2e79",
                                    "avatar_id": "julia"
                                },
                                {
                                    "id": "sp_julia6_future_goal_degree_succes",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "And you're still allowed to that masters degree, only you start a year later.",
                                    "name": "Julia",
                                    "name_color": "#ab2e79",
                                    "avatar_id": "julia"
                                },
                                {
                                    "id": "sp_julia7_future_goal_succes",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "&#91; Hugs you tightly &#93;",
                                    "name": "Julia",
                                    "name_color": "#ab2e79",
                                    "avatar_id": "julia",
                                    "answer_options": [
