        {
            "id": "epilogue_graduation1",
            "background": "bg/graduation.png",
            "objects": [
                {
                    "id": "graduation_ceremony",
                    "type": "scrollingdialogue",
                    "x": "20%",
                    "y": "8%",
                    "z": "1",                    
                    "width": "60%",
                    "height": "80%",
                    "visible": true,
                    "objects": [
                        {
                            "id": "top",
                            "type": "sprite",
                            "width": "88%",
                            "visible": true,
                            "text": "<h1>4 months later...</h1><p style='font-size: 1.2vw'>The graduation ceremony has just finished. Everyone is joyfully chatting and enjoying cocktails.</p>"
                        },
                        {
                            "id": "avatars",
                            "type": "avatars",
                            "visible": true,
                            "objects": [
                                {
                                    "id": "student",
                                    "name": "student",
                                    "img": "/project/img/avatars/student.png",
                                    "visible": true
                                },
                                {
                                    "id": "julia",
                                    "name": "teacher",
                                    "img": "/project/img/avatars/julia.png"
                                },
                                {
                                    "id": "teacher",
                                    "name": "teacher",
                                    "img": "/project/img/avatars/teacher.png",
                                    "visible": false
                                },
                                {
                                    "id": "lisa",
                                    "name": "lisa",
                                    "img": "/project/img/avatars/lisa.png",
                                    "visible": false
                                }
                            ]
                        },
                        {
                            "id": "texts",
                            "type": "texts",
                            "text_size": "15px",
                            "width": "90%",
                            "height": "80%",
                            "background": "#DDFFE0",
                            "visible": true,
                            "dialogue": [
                                {
                                    "id": "sp_student1",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "Pfew, that's that. The signature is in place, speeches done, let's have a drink! &#91;Walks to the table with chaimpaign glasses&#93;",
                                    "name": "You",
                                    "name_color": "#6143CF",
                                    "avatar_id": "student",
                                    "is_player": true
                                },
                                {
                                    "id": "sp_teacher1",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "&#91;Handshake&#93; Congrats with finishing your bachelors! Are you gonna miss it?",
                                    "name": "Teacher",
                                    "name_color": "#DC6060",
                                    "avatar_id": "teacher"
                                },
                                {
                                    "id": "sp_student2",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "Well honestly I ...",
                                    "name": "You",
                                    "name_color": "#6143CF",
                                    "avatar_id": "student",
                                    "is_player": true
                                },
                                {
                                    "id": "sp_teacher2",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "O wait a sec, there's a colegue of mine which I need to talk to. See ya!",
                                    "name": "Teacher",
                                    "name_color": "#DC6060",
                                    "avatar_id": "teacher"
                                },
                                {
                                    "id": "sp_lisa_1",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "&#91; Grimace &#93; So, that ended quickly!",
                                    "name": "Lisa",
                                    "name_color": "#F5B841",
                                    "avatar_id": "lisa"
                                },
                                {
                                    "id": "sp_student3",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "Not that I was going to give an honest answer either! But let's forget about it. Congrats btw!",
                                    "name": "You",
                                    "name_color": "#6143CF",
                                    "avatar_id": "student",
                                    "is_player": true
                                },
                                {
                                    "id": "sp_lisa_2",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "&#91;Hugs&#93; yeah you too! I am so relieved we made it!",
                                    "name": "Lisa",
                                    "name_color": "#F5B841",
                                    "avatar_id": "lisa"
                                },
                                {
                                    "id": "sp_lisa_3",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "So...",
                                    "name": "Lisa",
                                    "name_color": "#F5B841",
                                    "avatar_id": "lisa"
                                },
                                {
                                    "id": "sp_lisa_4",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "Do you have already more defined plans for what's next?",
                                    "name": "Lisa",
                                    "name_color": "#F5B841",
                                    "avatar_id": "lisa",
                                    "answer_options": [
                                        {
                                            "content": "[Next Degree]",
                                            "events": [
