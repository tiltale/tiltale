                    "visible": true,
                    "objects": [
                        {
                            "id": "top",
                            "type": "sprite",
                            "width": "88%",
                            "visible": true,
                            "text": "<h1>2 months later...</h1><p style='font-size: 1.2vw'>The winter supplies are stocked, the regular promotions are given, and everyone is enjoying the prospect of a cozy wintertime.</p>"
                        },
                        {
                            "id": "avatars",
                            "type": "avatars",
                            "visible": true,
                            "objects": [
                                {
                                    "id": "player",
                                    "name": "player",
                                    "img": "/project/img/avatars/player.png",
                                    "visible": true
                                },
                                {
                                    "id": "willaferna",
                                    "name": "willaferna",
                                    "img": "/project/img/avatars/willaferna.png"
                                },
                                {
                                    "id": "oakpaw",
                                    "name": "oakpaw",
                                    "img": "/project/img/avatars/oakpaw.png",
                                    "visible": false
                                },
                                {
                                    "id": "flicktail",
                                    "name": "flicktail",
                                    "img": "/project/img/avatars/flicktail.png",
                                    "visible": false
                                }
                            ]
                        },
                        {
                            "id": "texts",
                            "type": "texts",
                            "text_size": "15px",
                            "width": "90%",
                            "height": "80%",
                            "background": "#DDFFE0",
                            "visible": true,
                            "dialogue": [
                                {
                                    "id": "sp_player1",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "Pfew, that's that. The acorns are taxed, speeches done, let's have a some drinks! &#91; Walks to the table with Acorn Ale &#93;",
                                    "name": "You",
                                    "name_color": "#6143CF",
                                    "avatar_id": "player",
                                    "is_player": true
                                },
                                {
                                    "id": "sp_willaferna1",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "Haha, some fuss about the whole thing is only well deserved right? &#91; Hugs and toasts with you &#93;",
                                    "name": "Willaferna",
                                    "name_color": "#ab2e79",
                                    "avatar_id": "willaferna"
                                },
                                {
                                    "id": "sp_oakpaw1",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "&#91;Handshake&#93; Congrats with getting your promotion! Are you gonna miss the classes?",
                                    "name": "Oakpaw",
                                    "name_color": "#DC6060",
                                    "avatar_id": "oakpaw"
                                },
                                {
                                    "id": "sp_player2",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "Well honestly I ...",
                                    "name": "You",
                                    "name_color": "#6143CF",
                                    "avatar_id": "player",
                                    "is_player": true
                                },
                                {
                                    "id": "sp_oakpaw2",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "O wait a sec, there's a Elder Greyburrow which I need to talk to. See ya! &#91; Hips away &#93;",
                                    "name": "Oakpaw",
                                    "name_color": "#DC6060",
                                    "avatar_id": "oakpaw"
                                },
                                {
                                    "id": "sp_flicktail1",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "&#91; Grimace &#93; So, that ended quickly!",
                                    "name": "Flicktail",
                                    "name_color": "#F5B841",
                                    "avatar_id": "flicktail"
                                },
                                {
                                    "id": "sp_player3",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "Not that I was going to give an honest answer either! But let's forget about it. Congrats btw!",
                                    "name": "You",
                                    "name_color": "#6143CF",
                                    "avatar_id": "player",
                                    "is_player": true
                                },
                                {
                                    "id": "sp_flicktail2",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "&#91; Hugs &#93; yeah you too! I am so relieved we made it!",
                                    "name": "Flicktail",
                                    "name_color": "#F5B841",
                                    "avatar_id": "flicktail"
                                },
                                {
                                    "id": "sp_flicktail3",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "So...",
                                    "name": "Flicktail",
                                    "name_color": "#F5B841",
                                    "avatar_id": "flicktail"
                                },
                                {
                                    "id": "sp_flicktail4",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "Do you guys have already more defined plans for after winter time?",
                                    "name": "Flicktail",
                                    "name_color": "#F5B841",
                                    "avatar_id": "flicktail"
                                },
                                {
                                    "id": "sp_player4_future_aim_failed",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "Well uhm...  &#91; Looks at Willaferna &#93;",
                                    "name": "You",
                                    "name_color": "#6143CF",
                                    "avatar_id": "player",
                                    "is_player": true
                                },
                                {
                                    "id": "sp_willaferna2_future_aim_failed",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "We were going to work that out while [Name] had that extra promotion course. Turns out that was not doable at all.",
                                    "name": "Willaferna",
                                    "name_color": "#ab2e79",
                                    "avatar_id": "willaferna"
                                },
                                {
                                    "id": "sp_player5_future_aim_failed_house",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "So now we have to find another Nestling Nook, but you know how the Hollow Exchange is right now.",
                                    "name": "You",
                                    "name_color": "#6143CF",
                                    "avatar_id": "player",
                                    "is_player": true
                                },
                                {
                                    "id": "sp_player5_future_aim_failed_promotion",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "So now I have to wait another year for further promotion.",
                                    "name": "You",
                                    "name_color": "#6143CF",
                                    "avatar_id": "player",
                                    "is_player": true
                                },
                                {
                                    "id": "sp_player5_future_aim_failed_role",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "I couldn't attain the conference about the role changes in the tribe, so now I have to find something else.",
                                    "name": "You",
                                    "name_color": "#6143CF",
                                    "avatar_id": "player",
                                    "is_player": true
                                },
                                {
                                    "id": "sp_willaferna3_future_aim_failed",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "Luckily he has at least his regular promotion now. So that gives enough possibilities for the future. An we have each other. &#91; Smiles at you &#93;",
                                    "name": "Willaferna",
                                    "name_color": "#ab2e79",
                                    "avatar_id": "willaferna",
                                    "answer_options": [
                                        {
                                            "type": "next",
                                            "events": [
                                                {
                                                    "type": "goto_scene",
                                                    "target": "deliberation"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "sp_willaferna2_future_aim_succes",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "We worked that out while [Name] had that extra promotion course. In the end that project was going to fail anyways.",
                                    "name": "Willaferna",
                                    "name_color": "#ab2e79",
                                    "avatar_id": "willaferna"
                                },
                                {
                                    "id": "sp_flicktail5_future_aim_succes",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "&#91; Sighs &#93; Yeah right! What a mess was that!",
                                    "name": "Flicktail",
                                    "name_color": "#F5B841",
                                    "avatar_id": "flicktail"
                                },
                                {
                                    "id": "sp_willaferna3_future_aim_succes_house",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "We found a new Nestling Nook where we can start living together. &#91; Holds your arm tightly &#93;",
                                    "name": "Willaferna",
                                    "name_color": "#ab2e79",
                                    "avatar_id": "willaferna"
                                },
                                {
                                    "id": "sp_willaferna3_future_aim_succes_promotion",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "We both were accepted for the same extra promotion program. So we more or the less pushed back real decisions for another two years &#91; Winks at you &#93;",
                                    "name": "Willaferna",
                                    "name_color": "#ab2e79",
                                    "avatar_id": "willaferna"
                                },
                                {
                                    "id": "sp_willaferna3_future_aim_succes_role",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "[Name] got a new role in the tribe, so we are currently looking for an Nestling Nook to start living together. &#91; Holds your arm tightly &#93;",
                                    "name": "Willaferna",
                                    "name_color": "#ab2e79",
                                    "avatar_id": "willaferna"
                                },
                                {
                                    "id": "sp_flicktail6_future_aim_succes",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "Aww so nice for both of you! I am so happy for you both! &#91; Hugs you both &#93;",
                                    "name": "Flicktail",
                                    "name_color": "#F5B841",
                                    "avatar_id": "flicktail",
                                    "answer_options": [
                                        {
                                            "type": "next",
                                            "events": [
                                                {
                                                    "type": "goto_scene",
                                                    "target": "deliberation"
                                                }
                                            ]
                                        }
                                    ]
                                }                                                                                                                                                                                                                                                                                                                                                                             
                            ]
                        }
