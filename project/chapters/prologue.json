                            "visible": true,
                            "dialogue": [
                                {
                                    "id": "sp_player1",
                                    "type": "thought",
                                    "visible": false,
                                    "content": "Pfew, that's that. The acorns are taxed, speeches done, let's have a some fresh chestnuts! &#91; Walks to the table with burned chestnuts &#93;",
                                    "name": "You",
                                    "name_color": "#6143CF",
                                    "avatar_id": "player",
                                    "is_player": true
                                },
                                {
                                    "id": "sp_oakpaw1",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "&#91;Handshake&#93; Congrats with getting your promotion! Are you gonna miss the classes?",
                                    "name": "Elder Oakpaw",
                                    "name_color": "#DC6060",
                                    "avatar_id": "oakpaw"
                                },
                                {
                                    "id": "sp_player2",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "Well honestly I ...",
                                    "name": "You",
                                    "name_color": "#6143CF",
                                    "avatar_id": "player",
                                    "is_player": true
                                },
                                {
                                    "id": "sp_oakpaw2",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "O wait a sec, there's a Elder Greyburrow which I need to talk to. See ya! &#91; Hips away &#93;",
                                    "name": "Elder Oakpaw",
                                    "name_color": "#DC6060",
                                    "avatar_id": "oakpaw"
                                },
                                {
                                    "id": "sp_flicktail_1",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "&#91; Grimace &#93; So, that ended quickly!",
                                    "name": "Flicktail",
                                    "name_color": "#F5B841",
                                    "avatar_id": "flicktail"
                                },
                                {
                                    "id": "sp_player3",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "Not that I was going to give an honest answer either! But let's forget about it. Congrats btw!",
                                    "name": "You",
                                    "name_color": "#6143CF",
                                    "avatar_id": "player",
                                    "is_player": true
                                },
                                {
                                    "id": "sp_flicktail_2",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "&#91;Hugs&#93; yeah you too! I am so relieved we made it!",
                                    "name": "Flicktail",
                                    "name_color": "#F5B841",
                                    "avatar_id": "flicktail"
                                },
                                {
                                    "id": "sp_flicktail_3",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "So...",
                                    "name": "Flicktail",
                                    "name_color": "#F5B841",
                                    "avatar_id": "flicktail"
                                },
                                {
                                    "id": "sp_flicktail_4",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "Do you have already more defined plans for after wintertime?",
                                    "name": "Flicktail",
                                    "name_color": "#F5B841",
