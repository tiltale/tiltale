                                    "id": "sp_lisa10",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "Maybe [Name] can also do some character analyses, than the workload is devided more evenly.",
                                    "name": "Lisa",
                                    "name_color": "#F5B841",
                                    "avatar_id": "lisa"
                                },
