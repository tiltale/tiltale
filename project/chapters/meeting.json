                                    "name": "Lisa",
                                    "name_color": "#F5B841",
                                    "avatar_id": "lisa"
                                },
                                {
                                    "id": "sp_julian3",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "&#91;Shrugs his shoulders.&#93; Well sorry, I guess...",
                                    "name": "Julian",
                                    "name_color": "#632B30",
                                    "avatar_id": "julian"
                                },
                                {
                                    "id": "sp_julian4",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "I will start by doing some reading this week.",
