                                {
                                    "id": "sp_lisa1",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "Okay, let's start. Has everyone already read the assignment description?",
                                    "name": "Lisa",
                                    "name_color": "#F5B841",
                                    "avatar_id": "lisa"
                                },
                                {
                                    "id": "sp_student1",
                                    "type": "thought",
                                    "visible": false,
                                    "content": "Lisa for sure has.",
                                    "name": "You",
                                    "name_color": "#6143CF",
                                    "avatar_id": "student",
                                    "is_player": true
                                },
                                {
                                    "id": "sp_student2",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "Well yeah, I skimmed through it this morning.",
                                    "name": "You",
                                    "name_color": "#6143CF",
                                    "avatar_id": "student",
                                    "is_player": true
                                },
                                {
                                    "id": "sp_julian1",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "&#91;Yawns&#93; Well no, I did want to do it, but you know how things can go...",
                                    "name": "Julian",
                                    "name_color": "#632B30",
                                    "avatar_id": "julian"
                                },
                                {
                                    "id": "sp_student3",
                                    "type": "thought",
                                    "visible": false,
                                    "content": "Yeah right! I do smell a little alcohol, isn't it?",
