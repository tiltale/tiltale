                                    "avatar_id": "lisa"
                                },
                                {
                                    "id": "sp_lisa4",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "So the assignment comes down to preparing an act in which a dynamic between different characters in the workplace is portrayed.",
                                    "name": "Lisa",
                                    "name_color": "#F5B841",
                                    "avatar_id": "lisa"
                                },
                                {
                                    "id": "sp_lisa5",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "These characters should be based on the archetypes as described by Carl Jung.",
