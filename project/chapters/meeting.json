                                    "name_color": "#116592",
                                    "avatar_id": "cesare"
                                },
                                {
                                    "id": "sp_lisa7",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "Let's see...",
                                    "name": "Lisa",
                                    "name_color": "#F5B841",
                                    "avatar_id": "lisa"
                                },
                                {
                                    "id": "sp_lisa8",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "We need a list of events, an analysis of characters and an overal story outline which intergrates them.",
                                    "name": "Lisa",
                                    "name_color": "#F5B841",
                                    "avatar_id": "lisa"
                                },
                                {
                                    "id": "sp_lisa9",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "We also need to report on the overall process.",
                                    "name": "Lisa",
                                    "name_color": "#F5B841",
                                    "avatar_id": "lisa"
                                },
                                {
                                    "id": "sp_cesare3",
                                    "type": "speech",
                                    "visible": false,
                                    "content": "I will do the character analyses, if that's okay.",
                                    "name": "Cesare",
                                    "name_color": "#116592",
                                    "avatar_id": "cesare"
                                },
